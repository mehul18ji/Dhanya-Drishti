# ============================================================
# DhanyaDrishti — environment template
# Copy to `.env` in the repository root and adjust as needed.
# The frontend template lives in `frontend/.env.example`.
# ============================================================

# --- Backend (FastAPI) ---
APP_NAME=DhanyaDrishti
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in megabytes (PRD §7)
MAX_UPLOAD_MB=10

# Temporary prediction history expiry, in minutes (PRD §16)
HISTORY_EXPIRY_MINUTES=60

# Temporary runtime directory (SQLite + uploaded images + masks).
# Wiped at startup. Never treated as permanent storage.
RUNTIME_DIR=backend/.runtime

# Directory holding production model artifacts (loaded once at startup)
MODEL_DIR=backend/app/artifacts/production

# --- Frontend (Vite) — also set in frontend/.env ---
VITE_API_BASE_URL=http://localhost:8000
