# Browser-facing backend origin. No trailing slash and no /api/v1 path.
#
# Local development:
VITE_API_BASE_URL=http://localhost:8000
#
# Vercel: Project -> Settings -> Environment Variables
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com
# Vite inlines this value at build time, so redeploy after changing it.
